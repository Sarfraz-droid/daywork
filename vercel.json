{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "python3 scripts/check-site.py",
  "outputDirectory": "docs",
  "installCommand": "",
  "headers": [
    {"source": "/downloads/(.*)", "headers": [{"key": "Cache-Control", "value": "public, max-age=0, must-revalidate"}]},
    {"source": "/downloads/(.*).zip", "headers": [{"key": "Content-Disposition", "value": "attachment; filename=Daymark-macOS-arm64.zip"}]},
    {"source": "/(.*)", "headers": [{"key": "X-Content-Type-Options", "value": "nosniff"}, {"key": "Referrer-Policy", "value": "strict-origin-when-cross-origin"}]}
  ]
}
